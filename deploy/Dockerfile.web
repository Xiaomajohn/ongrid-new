# syntax=docker/dockerfile:1.7
# ongrid-web image — multi-stage. Stage 1 builds the SPA from web/, stage 2
# bakes the built assets into nginx. nginx.conf and TLS certs are bind-mounted
# at runtime by docker-compose, so operators can edit them without rebuilding.
# Build context MUST be the repo root (Dockerfile lives in deploy/, but it
# COPYs `web/` from the root).
#
# ── Proxy support (opt-in) ──
# Same --build-arg contract as the other Dockerfiles. npm natively honors
# HTTP_PROXY/HTTPS_PROXY/NO_PROXY for the registry fetch, and we also drop
# a `proxy=` line into /root/.npmrc so npm's transitive tooling (tarballs,
# postinstall scripts) picks it up too.
#   docker build --build-arg HTTPS_PROXY=http://user:pass@proxy:8080 ...
# Or `export HTTPS_PROXY=...` before `docker build` (buildkit ≥ 0.8
# propagates the standard env vars automatically). Unset ⇒ legacy behavior.

ARG VERSION=dev
ARG HTTP_PROXY=
ARG HTTPS_PROXY=
ARG NO_PROXY=localhost,127.0.0.1,.svc,.cluster.local

# ---------- Stage 1: build the SPA ----------
FROM node:20-alpine AS builder

ARG VERSION
# Proxy plumbing — npm honors HTTP_PROXY/HTTPS_PROXY natively, and we
# also write /root/.npmrc so the post-install / tarball fetch layer
# (`npm ci`, `npm run build` -> vite -> rollup -> ...) all go through
# the same proxy. Empty ARG defaults = legacy direct-connect behavior.
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ENV HTTP_PROXY=$HTTP_PROXY \
    HTTPS_PROXY=$HTTPS_PROXY \
    http_proxy=$HTTP_PROXY \
    https_proxy=$HTTPS_PROXY \
    NO_PROXY=$NO_PROXY \
    no_proxy=$NO_PROXY
RUN set -eux; \
    if [ -n "$HTTP_PROXY$HTTPS_PROXY" ]; then \
        { \
            printf 'proxy=%s\n' "${HTTPS_PROXY:-$HTTP_PROXY}"; \
            printf 'https-proxy=%s\n' "${HTTPS_PROXY:-$HTTP_PROXY}"; \
            if [ -n "$NO_PROXY" ]; then printf 'noproxy=%s\n' "$NO_PROXY"; fi; \
        } > /root/.npmrc; \
        echo "[ongrid] npm proxy configured (${HTTPS_PROXY:-$HTTP_PROXY})"; \
    else \
        rm -f /root/.npmrc; \
        echo "[ongrid] no npm proxy — direct connect"; \
    fi
WORKDIR /app

# Cache dependency install layer separately from the source tree.
# `--mount=type=cache,target=/root/.npm` keeps npm's package cache
# across rebuilds — without it `npm ci` always re-downloads ~300MB.
COPY web/package.json web/package-lock.json* ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci --prefer-offline

COPY web/ ./
# vite cache persists the build artefact cache between rebuilds too,
# so a no-op web build drops from ~40s to ~5s.
RUN --mount=type=cache,target=/root/.npm \
    --mount=type=cache,target=/app/node_modules/.vite \
    npm run build

# ---------- Stage 2: nginx + static assets ----------
FROM nginx:1.27-alpine

# Built SPA assets shipped inside the image so it can serve standalone if
# operators forget the bind-mount (ADR-008).
COPY --from=builder /app/dist/ /usr/share/nginx/html/

# Default fallback config — overridden by docker-compose bind-mount in
# production. Lets the image run as a smoke test image without extra files.
COPY deploy/nginx/nginx.conf /etc/nginx/nginx.conf

EXPOSE 80 443
