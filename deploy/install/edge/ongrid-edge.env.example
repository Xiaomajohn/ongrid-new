# ongrid-edge environment file - rendered by install-edge.sh to
# EDGE_ROOT/etc/ongrid-edge/ongrid-edge.env（EDGE_ROOT=${PREFIX}/ongrid-edge，
# 默认 /mnt/data/tools-temp/ongrid-edge/etc/ongrid-edge/ongrid-edge.env）。
# The systemd unit reads this via EnvironmentFile=. The ongrid-edge binary
# consumes these env vars directly (see internal/pkg/config/config.go:
# ONGRID_EDGE_CLOUD_ADDR / _ACCESS_KEY / _SECRET_KEY).

ONGRID_EDGE_CLOUD_ADDR=__CLOUD_ADDR__
ONGRID_EDGE_ACCESS_KEY=__ACCESS_KEY__
ONGRID_EDGE_SECRET_KEY=__SECRET_KEY__
ONGRID_EDGE_COLLECTOR_MODE=auto
# Path placeholders below are rendered by install-edge.sh to the operator
# --prefix (default /mnt/data/tools-temp) + the ongrid-edge namespace layer
# (EDGE_ROOT=${PREFIX}/ongrid-edge) at install time. The Go-side
# internal/pkg/config defaults to the historical /etc/ongrid-edge/...
# layout when these are unset, so explicitly writing them here keeps the
# runtime aligned with the systemd unit + apply-pending-upgrade.sh hook
# (which are also prefix-rendered). Re-running install-edge.sh re-renders
# these to the new --prefix, so a re-install with a different --prefix
# doesn't leave the runtime pointing at the old directory.
ONGRID_EDGE_SCRAPE_CONFIG_FILE=__SCRAPE_CONFIG_FILE__
ONGRID_EDGE_PLUGIN_BIN_DIR=__PLUGIN_BIN_DIR__
ONGRID_EDGE_PLUGIN_WORK_DIR=__PLUGIN_WORK_DIR__
ONGRID_EDGE_UPGRADE_STAGE_DIR=__UPGRADE_STAGE_DIR__
ONGRID_EDGE_COLLECTOR_INTERVAL=10s

# ---- Plugin runtime (ADR-015) ----------------------------------------
# Edge ID is needed by every plugin to inject the `edge_id` label set on
# outbound telemetry. Empty by default — plugins refuse to render config
# until operator sets this (auto-discovered ID will land here in PR-C2).
ONGRID_EDGE_ID=

# ---- Logs plugin (ADR-012) -------------------------------------------
# Off by default. Set ENABLED=true + ENDPOINT=https://<manager>/loki/api/v1/push
# to start shipping journald + file tail logs. AUTH_USER / AUTH_PASS
# default to the tunnel ACCESS_KEY / SECRET_KEY above (data plane and
# control plane share credentials per ADR-014 §决策第 2 条).
ONGRID_EDGE_PLUGIN_LOGS_ENABLED=false
ONGRID_EDGE_PLUGIN_LOGS_ENDPOINT=
# ONGRID_EDGE_PLUGIN_LOGS_AUTH_USER=  # defaults to ONGRID_EDGE_ACCESS_KEY
# ONGRID_EDGE_PLUGIN_LOGS_AUTH_PASS=  # defaults to ONGRID_EDGE_SECRET_KEY
# Spec is JSON; control which sources are tailed.
# ONGRID_EDGE_PLUGIN_LOGS_SPEC_JSON={"file_paths":["/var/log/syslog"]}
